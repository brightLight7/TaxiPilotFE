{
  "name": "taxi-pilot-ng",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "tw": "npx tailwindcss -i ./src/input.css -o ./src/output.css --watch",
    "lint": "eslint . --ext .ts,.js",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "dev:ssr": "ng run TaxiPilotNG:serve-ssr",
    "serve:ssr": "node dist/TaxiPilotNG/server/main.js",
    "build:ssr": "ng build && ng run TaxiPilotNG:server",
    "prerender": "ng run TaxiPilotNG:prerender"
  },
  "private": true,
  "dependencies": {
    "@angular-material-components/datetime-picker": "^16.0.1",
    "@angular-material-extensions/google-maps-autocomplete": "^16.3.1",
    "@angular/animations": "^16.2.12",
    "@angular/cdk": "~16.2.14",
    "@angular/common": "^16.2.0",
    "@angular/compiler": "^16.2.0",
    "@angular/core": "^16.2.0",
    "@angular/forms": "^16.2.12",
    "@angular/google-maps": "^16.2.14",
    "@angular/material": "~16.2.14",
    "@angular/platform-browser": "^16.2.0",
    "@angular/platform-browser-dynamic": "^16.2.0",
    "@angular/platform-server": "^16.2.0",
    "@angular/router": "^16.2.0",
    "@microsoft/signalr": "^8.0.7",
    "@ngrx/effects": "^16.3.0",
    "@ngrx/store": "^16.3.0",
    "@ngrx/store-devtools": "^16.3.0",
    "@nguniversal/express-engine": "^16.2.0",
    "bootstrap": "^5.3.3",
    "express": "^4.15.2",
    "font-awesome": "^4.7.0",
    "ng-recaptcha": "^12.0.0",
    "ngx-cookie-service": "^16.1.0",
    "rxjs": "~7.8.0",
    "sass": "^1.83.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.13.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^16.2.7",
    "@angular-eslint/builder": "16.3.1",
    "@angular-eslint/eslint-plugin": "16.3.1",
    "@angular-eslint/eslint-plugin-template": "16.3.1",
    "@angular-eslint/schematics": "16.3.1",
    "@angular-eslint/template-parser": "16.3.1",
    "@angular/cli": "^16.2.16",
    "@angular/compiler-cli": "^16.2.0",
    "@nguniversal/builders": "^16.2.0",
    "@types/express": "^4.17.0",
    "@types/google.maps": "^3.48.2",
    "@types/jasmine": "~4.3.0",
    "@types/node": "^16.11.7",
    "@typescript-eslint/eslint-plugin": "5.62.0",
    "@typescript-eslint/parser": "5.62.0",
    "autoprefixer": "^10.4.19",
    "cypress": "^14.4.0",
    "cypress-cucumber-preprocessor": "^4.3.1",
    "eslint": "^8.51.0",
    "jasmine-core": "~4.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.4.38",
    "sass-loader": "^16.0.2",
    "tailwindcss": "^3.4.3",
    "typescript": "~5.1.6"
  }
